# Environment variables for FoodAnalyzer-API

# Server Configuration
PORT=8000

# JWT Secret Key - IMPORTANT: Generate a secure random key for production!
# You can generate one using: openssl rand -hex 32
SECRET_KEY=your_secure_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis configuration (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# OCR configuration
TESSERACT_CMD=/usr/bin/tesseract

# API configuration
API_BASE_URL=https://api.example.com

# Hugging Face Transformers API key (optional)
HUGGING_FACE_API_KEY=your_api_key_here  # Get your API key from https://huggingface.co

# API keys and model names for different LLMs
LLM_API_KEY=your_llm_api_key # Here key from Google AI Studio
LLM_MODEL_NAME=gemini-2.0-flash # Model in use

GOOGLE_API_KEY=your_google_api_key # For Google search tool
GOOGLE_CSE_ID=your_google_cse_id # For Google search tool - more info on langchain tool google search

USDA_API_KEY=your_usda_api_key # For searching USDA dataset

# PostgreSQL Database URL
DATABASE_URL=postgresql://user:password@localhost/food_analyzer_db

# Vuforia keys
VUFORIA_SERVER_ACCESS_KEY=your_vuforia_server_access_key
VUFORIA_SERVER_SECRET_KEY=your_vuforia_server_secret_key
VUFORIA_TARGET_DATABASE_NAME=your_vuforia_target_database_name
VUFORIA_TARGET_DATABASE_ID=your_vuforia_target_db_id

# LangSmith tracing (optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=your_project_name

# Rate limiting configuration
PARALLEL_RATE_LIMIT=10
PUBCHEM_TIMEOUT=2
PUBCHEM_MAX_RETRIES=2
DUCKDUCKGO_RATE_LIMIT_DELAY=2
DUCKDUCKGO_MAX_RETRIES=2

# Testing/Debug options (set to false in production)
SEND_FAKE_TARGET=false
FAKE_TARGET_IMAGE_NAME=detected_Snack_0.13_db8318a668504073ad5fd0677187d305.jpg
